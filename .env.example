# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_DIMENSIONS=768

# Storage and upload configuration
SUPABASE_STORAGE_BUCKET=documents
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=500

# Chunking
MAX_CHUNK_CHARACTERS=1600
CHUNK_OVERLAP_CHARACTERS=250
DEFAULT_RETRIEVAL_COUNT=8
SIMILARITY_THRESHOLD=0.25

# Background jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Rate limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limit thresholds
MAX_UPLOADS_PER_HOUR=20
MAX_CHAT_REQUESTS_PER_MINUTE=30
MAX_RETRIES_PER_HOUR=10

# Monitoring (Sentry) — optional for local dev
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=